 "lines": [
  { "id": "L01", "text": "Nobody chose, so the fox chose for you. Throw it.", "em": ["fox", "Throw"],
    "clock": "3:24 AM · NIGHT FERRY", "gap": 0.45,
    "act": { "intensity": 0.5, "pace": 0.34, "speed": 0.95 } },
  { "id": "L02", "text": "Under the floor, the red eye is two steps from the music.", "em": ["two", "steps"], "tint": true, "gap": 0.3,
    "act": { "intensity": 0.6, "pace": 0.32, "speed": 0.95, "gain_db": 0 } },
  { "id": "L03", "text": "You take the music box from the little girl. She doesn't cry. She just smiles.", "em": ["smiles"], "gap": 0.35,
    "act": { "intensity": 0.5, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
  { "id": "L04", "text": "You run across the metal deck in your socks, and you grab the railing.", "em": ["railing"], "gap": 0.8,
    "act": { "intensity": 0.7, "pace": 0.36, "speed": 0.98, "gain_db": 1 } },
  { "id": "L05", "text": "It's warm. Like skin.", "say": "It's warm... Like skin.", "speaker": "sussurro", "vfx": "whisper",
    "em": ["skin"], "hit": true, "tint": true, "gap": 0.7,
    "act": { "intensity": 0.5, "pace": 0.32, "speed": 0.9, "gain_db": -2 } },
  { "id": "L06", "text": "You throw. The box spins into the fog, still playing.", "em": ["throw", "fog"], "gap": 0.35,
    "act": { "intensity": 0.7, "pace": 0.34, "speed": 0.96, "gain_db": 1 } },
  { "id": "L07", "text": "Something huge rolls after it, and the music sinks under the water.", "em": ["sinks"], "gap": 0.9,
    "act": { "intensity": 0.6, "pace": 0.32, "speed": 0.95, "gain_db": 0 } },
  { "id": "L08", "text": "Then, silence.", "em": ["silence"], "gap": 0.8,
    "act": { "intensity": 0.4, "pace": 0.3, "speed": 0.9, "gain_db": -3 } },
  { "id": "L09", "text": "At 3:41 AM, the engines start again, and the lights come back on.", "say": "At three forty-one a.m., the engines start again, and the lights come back on.",
    "em": ["engines"], "clock": "3:41 AM · NIGHT FERRY", "gap": 0.35,
    "act": { "intensity": 0.5, "pace": 0.34, "speed": 0.95, "gain_db": 0.5 } },
  { "id": "L10", "text": "Thank you, passengers. You may speak now.", "speaker": "uomo-radio", "vfx": "radio", "quote": true,
    "em": ["speak"], "gap": 0.4,
    "act": { "intensity": 0.45, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
  { "id": "L11", "text": "The mother wakes up, and you tell her that her little girl is safe.", "em": ["safe"], "gap": 0.8,
    "act": { "intensity": 0.5, "pace": 0.32, "speed": 0.95, "gain_db": 0 } },
  { "id": "L12", "text": "I don't have a daughter.", "speaker": "donna-misteriosa", "quote": true,
    "em": ["daughter"], "hit": true, "gap": 0.6,
    "act": { "intensity": 0.6, "pace": 0.3, "speed": 0.9, "gain_db": -1 } },
  { "id": "L13", "text": "The seat next to her is empty. Wet little footprints lead to the railing.", "em": ["empty", "footprints"], "tint": true, "gap": 0.5,
    "act": { "intensity": 0.6, "pace": 0.32, "speed": 0.94, "gain_db": 0 } },
