        "intensity": 0.55,
        "pace": 0.32,
        "speed": 0.96,
        "gain_db": 1
      }
    },
    {
      "id": "L04",
      "text": "Not tonight. Not next year either.",
      "em": [
        "either"
      ],
      "gap": 0.8,
      "act": {
        "intensity": 0.4,
        "pace": 0.32,
        "speed": 0.97
      }
    },
    {
      "id": "L05",
      "text": "Because starlight is old light.",
      "em": [
        "old"
