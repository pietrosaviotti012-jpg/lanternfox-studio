        "intensity": 0.35,
        "pace": 0.32,
        "speed": 0.96,
        "gain_db": -1
      }
    },
    {
      "id": "L06",
      "text": "The closest star's light takes over four years to reach you.",
      "em": [
        "four",
        "years"
      ],
      "gap": 0.7,
      "act": {
        "intensity": 0.4,
        "pace": 0.32,
        "speed": 0.97
      }
    },
    {
      "id": "L07",
      "text": "So for years, the sky looks perfectly normal.",
      "em": [
        "normal"
      ],
      "gap": 1.0,
      "act": {
        "intensity": 0.35,
        "pace": 0.32,
        "speed": 0.97,
        "gain_db": -1
      },
      "clock": "YEAR 1"
    },
    {
      "id": "L08",
      "text": "Then, one night, the first star blinks out.",
      "em": [
        "blinks",
        "out"
      ],
      "gap": 1.0,
      "act": {
        "intensity": 0.5,
        "pace": 0.32,
        "speed": 0.96,
        "gain_db": 0.5
      },
      "clock": "YEAR 4"
    },
    {
      "id": "L09",
      "text": "Sirius goes dark a few years later.",
