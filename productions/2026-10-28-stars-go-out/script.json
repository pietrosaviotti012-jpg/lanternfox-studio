      "gap": 0.35,
      "act": {
        "intensity": 0.5,
        "pace": 0.32,
        "speed": 0.97
      }
    },
    {
      "id": "L02",
      "text": "Not the Sun. Just the others, at midnight sharp.",
      "em": [
        "midnight"
      ],
      "gap": 0.6,
      "act": {
        "intensity": 0.4,
        "pace": 0.32,
        "speed": 0.97
      },
      "clock": "00:00 · TONIGHT"
    },
    {
      "id": "L03",
      "text": "And you wouldn't notice a thing.",
