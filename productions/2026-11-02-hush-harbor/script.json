 "lines": [
  { "id": "L01", "text": "It's 3:12 AM on the night ferry, and every engine just cut out.",
    "say": "It's three twelve a.m. on the night ferry, and every engine just cut out.",
    "em": ["ferry", "engine"], "clock": "3:12 AM · NIGHT FERRY", "gap": 0.3,
    "act": { "intensity": 0.5, "pace": 0.34, "speed": 0.95 } },
  { "id": "L02", "text": "The captain whispers one rule into the radio, so quietly you almost miss it.", "em": ["whispers"], "gap": 0.35,
    "act": { "intensity": 0.45, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
  { "id": "L03", "text": "From now on, nobody makes a sound.", "speaker": "uomo-radio", "vfx": "radio", "quote": true,
    "em": ["sound"], "gap": 0.4,
    "act": { "intensity": 0.45, "pace": 0.32, "speed": 0.95, "gain_db": -1 } },
  { "id": "L04", "text": "And every passenger around you is already taking off their shoes.", "em": ["already", "shoes"],
    "hit": true, "gap": 0.7,
    "act": { "intensity": 0.65, "pace": 0.32, "speed": 0.95, "gain_db": 0.5 } },
  { "id": "L05", "text": "Rule one. Phones off. Not silent. Off.", "em": ["off"], "gap": 0.35,
    "bar": [{ "label": "NOISE", "value": "2/10" }],
    "tv": { "title": "CAPTAIN'S ORDERS", "rule": "RULE #1", "text": "PHONES OFF", "ticker": "NOT SILENT · OFF · NO SCREENS · NO ALARMS" },
    "act": { "intensity": 0.5, "pace": 0.34, "speed": 0.95 } },
  { "id": "L06", "text": "Rule two. Nobody walks on the metal deck in shoes.", "em": ["metal"], "gap": 0.35,
    "tv": { "title": "CAPTAIN'S ORDERS", "rule": "RULE #2", "text": "SHOES OFF", "ticker": "THE DECK IS METAL · IT CARRIES EVERY STEP · WALK IN SOCKS" },
    "act": { "intensity": 0.5, "pace": 0.34, "speed": 0.95 } },
  { "id": "L07", "text": "Rule three. Never touch the railing, whatever you see out there.", "em": ["railing"], "gap": 0.7,
    "tv": { "title": "CAPTAIN'S ORDERS", "rule": "RULE #3", "text": "DON'T TOUCH THE RAILING", "ticker": "WHATEVER YOU SEE · WHATEVER YOU HEAR · STAY OFF THE RAILING" },
    "act": { "intensity": 0.5, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
  { "id": "L08", "text": "At 3:20, something big slides along the hull, slow and heavy.", "say": "At three twenty, something big slides along the hull, slow and heavy.",
    "em": ["slides"], "clock": "3:20 AM · NIGHT FERRY", "gap": 0.4,
    "bar": [{ "label": "NOISE", "value": "1/10" }],
    "act": { "intensity": 0.5, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
  { "id": "L09", "text": "It stops right under your feet, and the whole floor goes still.", "em": ["your"], "tint": true, "gap": 0.9,
    "act": { "intensity": 0.6, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
  { "id": "L10", "text": "It's listening.", "speaker": "sussurro", "vfx": "whisper", "em": ["listening"], "gap": 0.9,
    "act": { "intensity": 0.4, "pace": 0.32, "speed": 0.95, "gain_db": -2.5 } },
  { "id": "L11", "text": "Then, two rows ahead, a little girl opens a music box.", "em": ["music", "box"],
    "clock": "3:24 AM · NIGHT FERRY", "gap": 0.3,
    "act": { "intensity": 0.45, "pace": 0.32, "speed": 0.95, "gain_db": -0.5 } },
