{
  "title": "The Lighthouse Fox",
  "series": "Tales from the Lighthouse",
  "voice": {
    "engine": "chatterbox"
  },
  "lead": 1.6,
  "tail": 3.4,
  "lines": [
    {
      "id": "L01",
      "text": "Every night, the old lighthouse keeper left one window lit.",
      "gap": 0.5,
      "act": {
        "intensity": 0.45,
        "pace": 0.45,
        "speed": 0.9
      }
    },
    {
      "id": "L02",
      "text": "Not for the ships.",
      "gap": 0.35,
      "act": {
        "intensity": 0.5,
        "pace": 0.4,
        "speed": 0.88
      }
    },
    {
      "id": "L03",
      "text": "The ships had stopped coming years ago.",
      "gap": 0.9,
      "act": {
        "intensity": 0.4,
        "pace": 0.45,
        "speed": 0.88
      }
    },
    {
      "id": "L04",
      "text": "He left it on for a little fox who lived in the dunes,",
      "gap": 0.2,
      "act": {
        "intensity": 0.5,
        "pace": 0.4,
        "speed": 0.9
      }
    },
    {
      "id": "L05",
      "text": "a fox who was afraid of the dark.",
      "gap": 1.2,
      "act": {
        "intensity": 0.45,
        "pace": 0.4,
        "speed": 0.86,
        "gain_db": -1
      }
    },
    {
      "id": "L06",
      "text": "Then, one night, the storm came.",
      "gap": 0.4,
      "act": {
        "intensity": 0.7,
        "pace": 0.35,
        "speed": 0.92,
        "gain_db": 1
      }
    },
    {
      "id": "L07",
      "text": "The wind broke the glass, and the light went out.",
      "gap": 1.1,
      "act": {
        "intensity": 0.75,
        "pace": 0.35,
        "speed": 0.94,
        "gain_db": 1.5
      }
    },
    {
      "id": "L08",
      "text": "For the first time, the old man sat in the dark.",
      "gap": 1.3,
      "act": {
        "intensity": 0.35,
        "pace": 0.5,
        "speed": 0.84,
        "gain_db": -1.5
      }
    },
    {
      "id": "L09",
      "text": "Until he heard something on the stairs.",
      "gap": 0.35,
      "act": {
        "intensity": 0.3,
        "pace": 0.5,
        "speed": 0.86,
        "gain_db": -4
      }
    },
    {
      "id": "L10",
      "text": "Small steps. A warm glow.",
      "gap": 0.45,
      "act": {
        "intensity": 0.45,
        "pace": 0.45,
        "speed": 0.86,
        "gain_db": -2
      }
    },
    {
      "id": "L11",
      "text": "The little fox had brought him a lantern.",
      "gap": 1.3,
      "act": {
        "intensity": 0.6,
        "pace": 0.4,
        "speed": 0.88
      }
    },
    {
      "id": "L12",
      "text": "Now there are two lights on the hill, every night.",
      "gap": 0.3,
      "act": {
        "intensity": 0.5,
        "pace": 0.4,
        "speed": 0.88
      }
    },
    {
      "id": "L13",
      "text": "One for the fox, and one for the man who waited.",
      "gap": 0.2,
      "act": {
        "intensity": 0.55,
        "pace": 0.45,
        "speed": 0.84,
        "gain_db": -1
      }
    }
  ],
